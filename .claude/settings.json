{
  "permissions": {
    "allow": [
      "Bash(gh project view:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project item-list:*)",
      "Bash(.claude/gh-project.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii-guard.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create_pull_request|update_pull_request|issue_write|add_issue_comment|update_issue_comment|add_reply_to_pull_request_comment|add_comment_to_pending_review|pull_request_review_write|create_or_update_file|push_files)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
