# media-mount.env — settings for media-mount.sh. Copy to /boot/config/home0ps/media-mount.env on
# the MOS host (chmod 600) and fill in. Never commit the filled-in file.
RCLONE_CONFIG=/boot/config/<path>/rclone.conf
REMOTE=<crypt-remote>:<path>
MNT=/mnt/media
CACHE_DIR=/mnt/<pool>/<path>/rclone-cache
LOG_FILE=/mnt/<pool>/<path>/media-mount.log
CACHE_MAX_SIZE=100G
CACHE_MAX_AGE=168h
READ_AHEAD=256M
DIR_CACHE_TIME=15m
LXCS="kr-cxp-media-0101"
#RCLONE_BIN=/usr/bin/rclone
