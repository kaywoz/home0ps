# <appdata>/home0ps/apps-stack.env (/var/mergerfs/merger-nvme/disk1/mos-docker/appdata/home0ps/): settings for
# apps-stack.sh (host-local, not in git; 600).
# No secrets in here.
SHARE_USER=<the Samba-only data user>    # CannonCommander runs as it (docker-compose/homenas/README.md A-Q2)
SHARE_DATA=/mnt/user/1.data
SHARE_TMP=/mnt/user/tmp
# mediasort's token/tmdb/llm are created by the script: the token is reused from the mover's copy or generated,
# tmdb and llm are asked for at the terminal.
