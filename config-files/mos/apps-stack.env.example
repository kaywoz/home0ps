# /boot/config/home0ps/apps-stack.env: settings for apps-stack.sh (host-local, not in git; 600).
# No secrets in here.
SHARE_USER=<the Samba-only data user>    # CannonCommander runs as it (docker-compose/homenas/README.md A-Q2)
SHARE_DATA=/mnt/user/1.data
SHARE_TMP=/mnt/user/tmp
# Only while mediasort's token/tmdb/llm aren't on this host yet (scp over the tailnet):
MEDIASORT_SECRETS_FROM=root@<apps-vm>:/srv/docker/mediasort/secrets
