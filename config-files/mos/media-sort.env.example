# media-sort.env — settings for media-sort.py (kaywoz/home0ps#260). Copy to
# /var/mergerfs/merger-nvme/disk1/mos-docker/appdata/home0ps/media-sort.env
# on the MOS host (chmod 600) and fill in. Never commit the
# filled-in file.
RCLONE_CONFIG=/boot/config/<path>/rclone.conf
# download remote (emptied item by item) and library remote
SRC=<download-remote>:
LIB_REMOTE=<crypt-remote>:
# classifier library name = folder on the library remote; ';'-separated
LIBRARIES=movies=movies;xmovies=xmovies/<subfolder>;xtvshows=xtvshows;_sort/unsorted=_sort/unsorted
HOLDING=_sort
HOLDING_DAYS=30
# duplicates/collisions are parked on the download remote (server-side move, no transfer);
# default <download-remote>:_sort
#SRC_HOLDING=<download-remote>:_sort
# classifier: mediasort in the homenas apps stack, on this host (docker-compose/homenas/apps)
CLASSIFIER_URL=http://127.0.0.1:8089
TOKEN_FILE=/var/mergerfs/merger-nvme/disk1/mos-docker/appdata/home0ps/media-sort.token
# home0ps Healthchecks (svc:healthchecks on the monitoring host, not the cloud service) and the
# project's ping key (a secret; Project -> Settings -> Ping key). Checks media-sort-<job>-<host>
# (sort, junk, holding) are created on their first ping; the run summary is the ping body.
HC_URL=https://healthchecks.<tailnet>.ts.net
HC_PING_KEY=
# optional, instead of the two above: one check's own ping URL, shared by all jobs
#PING_URL=https://healthchecks.<tailnet>.ts.net/ping/<check-uuid>
# /var/log shows in the MOS UI; it is RAM, so the log is capped (LOG_MAX_KB) and lost on reboot
LOG_FILE=/var/log/media-sort.log
LOG_MAX_KB=2048
# items younger than this (minutes) are left for the next run
MIN_AGE_MIN=15
# 1 = act; anything else = dry run (log only). Switch on per job after checking a dry run.
RUN_SORT=0
RUN_JUNK=0
RUN_HOLDING=0
#RCLONE_BIN=/usr/bin/rclone
# daily Slack digest: file holding the Slack incoming-webhook URL (600, root); RUN_DIGEST=1 sends
SLACK_WEBHOOK_FILE=/var/mergerfs/merger-nvme/disk1/mos-docker/appdata/home0ps/media-sort.slack
RUN_DIGEST=0
# a move cut short (Ctrl-C, kill, reboot) is recorded here and finished by the next real sort run
STATE_FILE=/var/mergerfs/merger-nvme/disk1/mos-docker/appdata/home0ps/media-sort.inprogress
