# media-sort.env — settings for media-sort.py (kaywoz/home0ps#260). Copy to
# /boot/config/home0ps/media-sort.env on the MOS host (chmod 600) and fill in. Never commit the
# filled-in file.
RCLONE_CONFIG=/boot/config/<path>/rclone.conf
# download remote (emptied item by item) and library remote
SRC=<download-remote>:
LIB_REMOTE=<crypt-remote>:
# classifier library name = folder on the library remote; ';'-separated
LIBRARIES=movies=movies;xmovies=xmovies/<subfolder>;xtvshows=xtvshows;_sort/unsorted=_sort/unsorted
HOLDING=_sort
HOLDING_DAYS=30
# duplicates/collisions are parked on the download remote (server-side move, no transfer);
# default <download-remote>:_sort
#SRC_HOLDING=<download-remote>:_sort
# classifier on the apps VM over the tailnet (tailscale serve --tcp=8089 there)
CLASSIFIER_URL=http://<apps-vm-tailnet-name>:8089
TOKEN_FILE=/boot/config/home0ps/media-sort.token
# ping URL of this job's check on the home0ps Healthchecks (svc:healthchecks on the monitoring
# host, not the cloud service); the run summary is sent as the ping body
PING_URL=https://healthchecks.<tailnet>.ts.net/ping/<check-uuid>
# /var/log shows in the MOS UI; it is RAM, so the log is capped (LOG_MAX_KB) and lost on reboot
LOG_FILE=/var/log/media-sort.log
LOG_MAX_KB=2048
# items younger than this (minutes) are left for the next run
MIN_AGE_MIN=15
# 1 = act; anything else = dry run (log only). Switch on per job after checking a dry run.
RUN_SORT=0
RUN_JUNK=0
RUN_HOLDING=0
#RCLONE_BIN=/usr/bin/rclone
# daily Slack digest: file holding the Slack incoming-webhook URL (600, root); RUN_DIGEST=1 sends
SLACK_WEBHOOK_FILE=/boot/config/home0ps/media-sort.slack
RUN_DIGEST=0
# a move cut short (Ctrl-C, kill, reboot) is recorded here and finished by the next real sort run
STATE_FILE=/boot/config/home0ps/media-sort.inprogress
