# /boot/config/home0ps/nic-watchdog.env, host-local, mode 600, root (never in git: HC_PING_KEY is a secret).
# Every line is optional; the script's defaults are shown commented out.
#NIC_PCI=0000:01:00.0
#PROBE_TARGET=            # default: the default gateway
#PROBE_SIZE=1000
#PROBES=3
#MAX_PER_HOUR=4
#COOLDOWN_MIN=10
#LOG_FILE=/var/log/nic-watchdog.log
#LOG_MAX_KB=256
#EVENT_FILE=/boot/config/home0ps/nic-watchdog.events
#HC_URL=https://healthchecks.<tailnet>.ts.net
#HC_PING_KEY=             # project ping key; check nic-watchdog-<host> is created on the first ping
#HC_PING_URL=             # optional: a check's own ping URL instead of the two above
