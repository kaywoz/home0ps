# Render: d2 d2/homelab-topology.d2 d2/homelab-topology.svg  (layout: elk, set below)
vars: {
  d2-config: {
    layout-engine: elk
  }
}
title: org-domain home0ps {
  near: top-center
  shape: text
  style: {
    font-size: 29
    bold: true
    underline: true
  }
}
Network.Internet <-> Network."ISP router": 2x600/60Mbps
Network."ISP router" <-> Network.UCG: bridged
Network.UCG <-> Network.Pro max switch
Network.Pro max switch <-> Network.Pro AP: 1gbe poe
Network.Pro max switch <-> Network.Jetkvm1: 1gbe
Network.Pro max switch <-> Network.Jetkvm2: 1gbe
Network.Pro max switch <-> Network.Jetkvm3: 1gbe
Network.Pro max switch <-> Network.Hue-bridge: 1gbe
Network.Pro max switch <-> Network.Ps5: 1gbe
Network.Pro max switch <-> Network.Macmini: 2.5gbe
Network.Pro max switch <-> Network.Hypervisor1: 2.5gbe
Network.Pro max switch <-> Network.Hypervisor2: 2.5gbe
Network.Pro max switch <-> Network.Nas: 2.5gbe
Network.Pro max switch <-> Network.Pi5: 1gbe
Network.Pro AP <-> Network.Lite AP: mesh {style.animated: true}

Compute.Hypervisor1.XCP-ng: {
  explanation: |md
    24t/128gb/6tb nvme/2tb ssd/1x2.5gbe
  |
}
Compute.Hypervisor2.XCP-ng: {
  explanation: |md
    24t/112gb/6tb nvme/2tb ssd/1x2.5gbe
  |
}
Compute.Pi5.Docker: {
  explanation: |md
    4t/8gb/128gb nvme/1x1gbe
  |
}
Compute.Pi5.Monitoring: {
  explanation: |md
    docker-compose/monitoring: gatus, beszel hub + agent, dozzle, docker socket proxy
  |
}
Storage.Nas.MOS: {
  explanation: |md
    4t/48gb/4tb nvme/8tb ssd/1x2.5gbe
  |
}
Storage.Cloud.Onedrive: {
  explanation: |md
    1tb
  |
}
Storage.Cloud.Filen: {
  explanation: |md
    200gb
  |
}
Storage.Cloud.Storadera S3: {
  explanation: |md
    1tb
  |
}
Storage.Cloud."Hetzner S3": {
  explanation: |md
    1tb
  |
}
Storage.Cloud."Hetzner Storagebox": {
  explanation: |md
    5tb
  |
}
Storage.Cloud."Put.io": {
  explanation: |md
    100gb
  |
}

# DNS and tailnet layer
Edge."Cloudflare DNS": {
  "org-domain"
  "hacking-domain"
  "phish-domain"
}
Edge.Tailnet."Tailscale Services": {
  explanation: |md
    gatus, cockpit, beszel, dozzle
  |
}
Edge.Tailnet."NPM 0101": {
  explanation: |md
    *.0101.int.org-domain
  |
}
Edge."Cloudflare DNS"."org-domain" -> Edge.Tailnet."NPM 0101": "wildcard -> tailscale ip"
Edge.Tailnet."NPM 0101" -> Network.Nas: runs on
Edge.Tailnet."Tailscale Services" -> Network.Pi5: monitoring
IaC."GitHub Actions" -> Edge."Cloudflare DNS": dns records
IaC."GitHub Actions" -> Edge.Tailnet: acl + services
IaC."GitHub Actions" -> Storage.Cloud."Hetzner S3": tofu state

Services.selfhosted.example: {
  explanation: |md
    samplename
  |
}

VMs.selfhosted.example: {
  explanation: |md
    samplename
  |
}

