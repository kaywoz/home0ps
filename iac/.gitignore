#############################################
# OpenTofu / Terraform
#############################################

# Local state files (never commit)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Local working directory
.terraform/

# Lock files ARE committed under iac/ (exact provider versions + hashes).
# Overrides the repo-root .gitignore, which ignores them everywhere else.
!.terraform.lock.hcl

#############################################
# Sensitive variable files
#############################################

# Never commit secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
secrets.auto.tfvars

#############################################
# Editor / OS junk
#############################################

# macOS
.DS_Store

# VS Code
.vscode/
.history/

# JetBrains
.idea/

# Windows
Thumbs.db

#############################################
# Logs
#############################################
*.log

#############################################
# Python virtualenvs (if you ever use them)
#############################################
venv/
.env/
