// This tailnet's ACLs are maintained in https://github.com/kaywoz/home0ps (iac/tailscale/policy.hujson)
{
	"groups": {
		"group:privusers": ["${TS_PRIVUSER}"],
		"group:guests":    ["${TS_GUEST}"],
	},

	"tagOwners": {
		//tags for types of devices and machines etc
		"tag:hypervisor": ["group:privusers"], //xcp-ng nodes

		"tag:storage":    ["group:privusers"], //all storage nodes
		"tag:service":    ["group:privusers"], //all services
		"tag:docker":     ["group:privusers"], //all docker nodes
		"tag:oob":        ["group:privusers"], //all oob-devices
		"tag:security":   ["group:privusers"], //all security devices and infra
		"tag:monitoring": ["group:privusers"], //RENAMING to tag:monitor -- remove once devices are retagged
		"tag:proxy":      ["group:privusers"], //TODO: description
		"tag:guests":     ["group:privusers"], //guest assets
		"tag:trusted":    ["group:privusers"], //natively trusted assets
		"tag:ha":         ["group:privusers"], //all home automation
		"tag:exit-node":  ["group:privusers"], //all exit-nodes
		"tag:auto":       ["group:privusers"], //deployed via pipeline
		"tag:ssh":        ["group:privusers"], //tailscale ssh access
		"tag:test":       ["group:privusers"], //just a test tag
		"tag:mgmt":       ["group:privusers"], //mgmt ui still exposed directly on 80/443, not yet behind proxy
		"tag:monitored":  ["group:privusers"], //RENAMING to tag:observed -- remove once devices are retagged
		"tag:monitor":    ["group:privusers"], //monitoring host(s): observation-only, pulls from observed hosts
		"tag:observed":   ["group:privusers"], //hosts/collectors shipping logs, pinging healthchecks, pulled by the monitor

		///////////////////////////////////////////////////////////////////
		//"tag:app-golink":       ["group:privusers"], //golink container access
		//"tag:app-docker-socket-proxy":       ["group:privusers"], //docker-socket-proxy container access
		//"tag:app-dockge":       ["group:privusers"], //dockge container access
		//"tag:app-beszel-agent":       ["group:privusers"], //TODO: description
	},

	"hosts": {
		// "some subnet": "192.168.199.0/24" //sample net not in use
		"macmini": "100.75.202.14",
	},

	"ssh": [
		// privusers and trusted devices can tailscale-ssh to all devices with the admin/root accounts.
		// ssh dst can't be "*": every tag is listed -- add new tags here too.
		{
			"action":      "check",
			"src":         ["group:privusers"],
			"dst": [
				"autogroup:self",
				"tag:hypervisor", "tag:storage", "tag:service", "tag:docker", "tag:oob",
				"tag:security", "tag:monitoring", "tag:proxy", "tag:guests", "tag:trusted",
				"tag:ha", "tag:exit-node", "tag:auto", "tag:ssh", "tag:test", "tag:mgmt", "tag:monitored", "tag:monitor", "tag:observed",
			],
			"users":       ["${LOCAL_UNIX_ACCOUNT}", "root"],
			"checkPeriod": "24h",
		},
		{
			// tagged sources can't ssh into user-owned devices, so tags only
			"action": "accept",
			"src":    ["tag:trusted"],
			"dst": [
				"tag:hypervisor", "tag:storage", "tag:service", "tag:docker", "tag:oob",
				"tag:security", "tag:monitoring", "tag:proxy", "tag:guests", "tag:trusted",
				"tag:ha", "tag:exit-node", "tag:auto", "tag:ssh", "tag:test", "tag:mgmt", "tag:monitored", "tag:monitor", "tag:observed",
			],
			"users":  ["${LOCAL_UNIX_ACCOUNT}", "root"],
		},
	],

	"nodeAttrs": [
		{
			"target": ["autogroup:member", "tag:test"],
			"attr":   ["funnel"],
		},
	],

	// Tailscale Services (defined in iac/tailscale-services/): hosts tagged
	// tag:monitor (and tag:monitoring during the rename) may advertise these without manual approval.
	"autoApprovers": {
		"services": {
			"svc:gatus":   ["tag:monitoring", "tag:monitor"],
			"svc:cockpit": ["tag:monitoring", "tag:monitor"],
			"svc:beszel":  ["tag:monitoring", "tag:monitor"],
			"svc:dozzle":  ["tag:monitoring", "tag:monitor"],
			"svc:logtide":     ["tag:monitoring", "tag:monitor"],
			"svc:logtide-api": ["tag:monitoring", "tag:monitor"],
			"svc:healthchecks": ["tag:monitoring", "tag:monitor"],
		},
	},

	//****************************************************
	//************************GRANTs************************
	//****************************************************

	"grants": [
		{
			// ssh (tailscale ssh + regular sshd) to all devices
			"src": ["tag:trusted", "group:privusers"],
			"dst": ["*"],
			"ip":  ["tcp:22"],
		},
		{
			// mgmt ports (80/443) on all devices -- mgmt uis should end up behind the proxy
			"src": ["tag:trusted", "group:privusers"],
			"dst": ["*"],
			"ip":  ["tcp:80", "tcp:443"],
		},
		{
			// TEST RULE: app on placeholder -- devices tagged tag:test only, remove once the app is sorted
			"src": ["tag:trusted", "group:privusers"],
			"dst": ["tag:proxy"],
			"ip":  ["tcp:8080", "tcp:81","tcp:443"],
		},

		// !!! BREAK-GLASS ONLY -- TEST RULE, DISABLED !!!
		// Full TCP from trusted devices/privusers to everything. Uncomment only in a
		// break-the-glass scenario, via PR, and re-comment once resolved.
		//{
		//	"src": ["tag:trusted", "group:privusers"],
		//	"dst": ["*"],
		//	"ip":  ["tcp:*"],
		//},

		{
			"src": ["tag:security", "tag:monitoring", "tag:monitor"],
			"dst": ["*"],
			"ip":  ["icmp:*"],
		},
		{
			// admins -> admin UIs by service name (not by node/port)
			"src": ["autogroup:admin"],
			"dst": ["svc:gatus", "svc:cockpit", "svc:beszel", "svc:dozzle", "svc:logtide", "svc:logtide-api", "svc:healthchecks"],
			"ip":  ["tcp:443"],
		},
		{
			// log shippers (tailscale devices, remote syslog collectors) -> log ingest
			"src": ["tag:monitored", "tag:observed"],
			"dst": ["svc:logtide-api"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["tag:proxy"],
			"dst": ["tag:service"],
			"ip":  ["tcp:*"],
		},
		{
			"src": ["tag:trusted", "group:privusers"],
			"dst": ["tag:proxy"],
			"ip":  ["tcp:*"],
		},
		{
			"src": ["tag:trusted", "group:privusers"],
			"dst": ["tag:storage"],
			"ip":  ["tcp:*"],
		},
		{
			//ha to synonology dsm portal
			"src": ["tag:ha"],

			"dst": ["tag:storage"],
			"ip":  ["tcp:*"],
		},
		{
			"src": ["tag:monitoring", "tag:monitor"],
			"dst": ["macmini"],
			"ip":  ["tcp:45876"],
		},
		{
			// observed hosts ping job heartbeats (tailnet only; healthchecks isn't published elsewhere)
			"src": ["tag:observed"],
			"dst": ["svc:healthchecks"],
			"ip":  ["tcp:443"],
		},
		{
			// monitor pulls agents on observed hosts: beszel agent, dozzle agent
			"src": ["tag:monitor"],
			"dst": ["tag:observed"],
			"ip":  ["tcp:45876", "tcp:7007"],
		},
	],

	"tests": [
		{
			"src":    "tag:trusted", //test that trusted devices always can access ssh
			"accept": ["tag:ssh:22"],
		},
		{
			// trusted devices reach the reverse proxies on their ports (http, https, npm admin)
			"src":    "tag:trusted",
			"accept": ["tag:proxy:80", "tag:proxy:443", "tag:proxy:81"],
		},
		{
			// privusers reach the reverse proxies on their ports (http, https, npm admin)
			"src":    "${TS_PRIVUSER}",
			"accept": ["tag:proxy:80", "tag:proxy:443", "tag:proxy:81"],
		},
		{
			// break-glass must stay off: no catch-all tcp from trusted devices/privusers
			"src":  "tag:trusted",
			"deny": ["tag:hypervisor:8080", "tag:docker:3389"],
		},
		{
			// break-glass must stay off: no catch-all tcp from trusted devices/privusers
			"src":  "${TS_PRIVUSER}",
			"deny": ["tag:hypervisor:8080", "tag:docker:3389"],
		},
		{
			// admin UIs are reached via Tailscale Services only; old per-port paths stay closed
			"src":  "${TS_PRIVUSER}",
			"deny": ["tag:monitoring:9090", "tag:monitoring:8443"],
		},
		{"src": "tag:monitoring", "accept": ["macmini:45876"], "deny": ["macmini:22"]},
		{
			// log shippers reach log ingest only, nothing else on the monitoring host
			"src":    "tag:monitored",
			"accept": ["svc:logtide-api:443"],
			"deny":   ["tag:monitoring:22", "tag:monitoring:443"],
		},
		{
			// new tag names: log shippers reach ingest + heartbeats only
			"src":    "tag:observed",
			"accept": ["svc:logtide-api:443", "svc:healthchecks:443"],
			"deny":   ["tag:monitor:22", "tag:monitor:443", "tag:observed:45876"],
		},
		{
			// new tag names: the monitor pulls agents, nothing else
			"src":    "tag:monitor",
			"accept": ["tag:observed:45876", "tag:observed:7007", "macmini:45876"],
			"deny":   ["tag:observed:22", "macmini:22"],
		},
		{
			// old per-port admin UI paths stay closed under the new tag too
			"src":  "${TS_PRIVUSER}",
			"deny": ["tag:monitor:9090", "tag:monitor:8443"],
		},
	],
}
