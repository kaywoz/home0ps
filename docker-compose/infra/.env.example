# Copy to /srv/docker/.env on the infra VM (chmod 600). Never commit the filled-in file.
BESZEL_LISTEN=         # <tailnet-ip>:45876  (tailscale ip -4)
BESZEL_HUB_URL=        # https://beszel.<tailnet>.ts.net
BESZEL_KEY=            # hub's PUBLIC key (Beszel UI -> Add system)
BESZEL_TOKEN=          # from the same dialog
