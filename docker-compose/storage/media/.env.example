# PROPOSAL — media stack settings. Copy to .env next to compose.yaml on the storage host (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
MEDIA_MNT=/mnt/media                 # MNT from media-mount.env
RENDER_GID=<getent group render | cut -d: -f3>
VLAN13_PARENT=<nic>.13
VLAN13_SUBNET=<subnet>/24
VLAN13_GATEWAY=<gateway>
VLAN13_RANGE=<small block outside DHCP>/28
JELLYFIN_IP=<fixed address in VLAN13_RANGE>
HOMEY_IP=<fixed address in VLAN13_RANGE>
TS_HOSTNAME=<MagicDNS name for the media sidecar>
