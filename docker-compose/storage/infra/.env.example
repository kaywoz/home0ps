# PROPOSAL — infra stack settings. Copy to .env next to compose.yaml on the storage host (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
VLAN24_PARENT=<nic>.24
VLAN24_SUBNET=<subnet>/24
VLAN24_GATEWAY=<gateway>
VLAN24_RANGE=<small block outside DHCP>/28
VLAN13_PARENT=<nic>.13               # media zone (the media stack joins this network)
VLAN13_SUBNET=<subnet>/24
VLAN13_GATEWAY=<gateway>
VLAN13_RANGE=<small block outside DHCP>/28
VLAN31_PARENT=<nic>.31               # apps zone (the apps stack joins this network)
VLAN31_SUBNET=<subnet>/24
VLAN31_GATEWAY=<gateway>
VLAN31_RANGE=<small block outside DHCP>/28
TS_HOSTNAME_MEDIA=<MagicDNS name for the media sidecar>
TS_HOSTNAME_APPS=<MagicDNS name for the apps sidecar>
BESZEL_LISTEN=<tailnet-ip>:45876     # the storage host's own tailnet IP (tailscale ip -4)
TAILNET=<tailnet>                    # the tailnet's MagicDNS name, for the Beszel HUB_URL
