# PROPOSAL — infra stack settings. Copy to .env next to compose.yaml on the storage host (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
VLAN24_PARENT=<nic>.24
VLAN24_SUBNET=<subnet>/24
VLAN24_GATEWAY=<gateway>
VLAN24_RANGE=<small block outside DHCP>/28
