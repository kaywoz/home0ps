# PROPOSAL — apps stack settings. Copy to .env next to compose.yaml on the storage host (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
SHARES=/mnt/<pool>/<share>           # what FileBrowser Quantum serves
VLAN31_PARENT=<nic>.31
VLAN31_SUBNET=<subnet>/24
VLAN31_GATEWAY=<gateway>
VLAN31_RANGE=<small block outside DHCP>/28
TS_HOSTNAME=<MagicDNS name for the apps sidecar>
PAPERLESS_URL=https://<paperless hostname>
RENDER_GID=<getent group render | cut -d: -f3>
PHOTOS=/mnt/<pool>/<photos>          # Immich UPLOAD_LOCATION
TAILNET=<tailnet>                    # the tailnet's MagicDNS name (HedgeDoc's CMD_DOMAIN)
ARCHIVEBOX_IP=<fixed address in VLAN31_RANGE>
WARRIOR_IP=<fixed address in VLAN31_RANGE>
