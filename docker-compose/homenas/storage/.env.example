# PROPOSAL — storage stack settings. Copy to .env next to compose.yaml on the homenas (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
BACKUPS=/mnt/<pool>/<backups>        # Kopia repository
TIMEMACHINE=/mnt/<pool>/<timemachine>
S3DATA=/mnt/<pool>/<s3>              # RustFS buckets
LAN_PARENT=<the host's own interface>   # Time Machine's macvlan parent (the homenas's own network)
LAN_SUBNET=<subnet>/24
LAN_GATEWAY=<gateway>
LAN_RANGE=<small block outside DHCP>/30
TIMEMACHINE_IP=<fixed address in LAN_RANGE>
RUSTFS_CONSOLE_ORIGIN=https://rustfs.<tailnet>.ts.net
SCRUTINY_API=https://scrutiny.<tailnet>.ts.net   # the hub on the monitoring host (svc:scrutiny)
