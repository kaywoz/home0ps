# Infra stack settings. Copy to .env next to compose.yaml on the homenas (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/var/mergerfs/merger-nvme/disk1/mos-docker/appdata   # MOS's own appdata folder (docker.json), never the RAM rootfs
BESZEL_LISTEN=<tailnet-ip>:45876     # the homenas's own tailnet IP (tailscale ip -4)
TAILNET=<tailnet>                    # the tailnet's MagicDNS name, for Arcane's URL and the Beszel HUB_URL
TZ=<Area/City>                       # IANA time zone name; Arcane schedules git syncs with it
