# PROPOSAL — infra stack settings. Copy to .env next to compose.yaml on the homenas (600) and fill in.
# Never commit the filled-in file: it holds addresses and host-specific paths.
APPDATA=/mnt/<pool>/appdata          # on the pool, never MOS's RAM rootfs
BESZEL_LISTEN=<tailnet-ip>:45876     # the homenas's own tailnet IP (tailscale ip -4)
TAILNET=<tailnet>                    # the tailnet's MagicDNS name, for the Beszel HUB_URL
