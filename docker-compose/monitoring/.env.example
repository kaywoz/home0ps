# Copy to .env on the host and fill in. .env is never committed (chmod 600).
# Comments stay on their own lines: a comment after a value can end up in the value.

# Hub's PUBLIC key, derived from the hub's own key file (no copy-paste):
#   K=$(sudo ssh-keygen -y -f beszel/hub-data/id_ed25519) && sed -i "s|^BESZEL_HUB_PUBKEY=.*|BESZEL_HUB_PUBKEY=\"$K\"|" .env
BESZEL_HUB_PUBKEY=

# This host's MagicDNS name, <hostname>.<tailnet>.ts.net, as shown in Dozzle
DOZZLE_HOSTNAME=

# tcp://<tailnet-ip>:2375|<hostname>.<tailnet>.ts.net[,...]: read-only socket proxies on observed
# hosts, each labelled with its MagicDNS name (actual hostname + tailnet), not a role name
DOZZLE_REMOTE_HOST=

# <tailnet>.ts.net, used for service URLs (Beszel, Healthchecks)
TS_TAILNET_DOMAIN=

# Generated by hc-setup.sh
HC_SECRET_KEY=
