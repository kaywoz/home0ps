# Copy to .env on the host and fill in. .env is never committed (chmod 600).
BESZEL_HUB_PUBKEY=     # hub's PUBLIC key (Beszel UI -> Add system)
DOZZLE_HOSTNAME=       # this host's MagicDNS name, <hostname>.<tailnet>.ts.net, as shown in Dozzle
DOZZLE_REMOTE_HOST=    # tcp://<tailnet-ip>:2375|<hostname>.<tailnet>.ts.net[,...] — read-only socket proxies on
                       # observed hosts, each labelled with its MagicDNS name (actual hostname + tailnet), not a role name
TS_TAILNET_DOMAIN=     # <tailnet>.ts.net, used for service URLs (Beszel, LogTide, Healthchecks)

# Generated by logtide-setup.sh (don't hand-write):
LOGTIDE_DB_NAME=
LOGTIDE_DB_USER=
LOGTIDE_DB_PASSWORD=
LOGTIDE_REDIS_PASSWORD=
LOGTIDE_API_KEY_SECRET=

# Generated by hc-setup.sh:
HC_SECRET_KEY=
